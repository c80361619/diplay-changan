<!-- API 21+: original Material theme (windowLightStatusBar needs 23 and is omitted:
     pre-23 status bars are dark-on-light anyway, matching this dark theme's white icons). -->
<resources>
    <style name="Theme.Xcertplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A6C8FF</item>
        <item name="android:navigationBarColor">#0C111B</item>
        <item name="android:statusBarColor">#0C111B</item>
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
